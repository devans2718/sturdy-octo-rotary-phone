# Copy to .env (or just export these) before running `streamlit run app.py`.
# The app also lets you paste keys in the Settings page; env vars win by default.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, llama.cpp server,
# OpenRouter, Together, Groq, ...). Configure the rest in the Settings page.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=not-needed

# Storage location (optional)
JOBHUNT_DB=data/jobhunt.db
